<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GrokWriter</RootNamespace>
    <!-- Copy sounds to output so they're next to the exe -->
    <DefaultItemExcludes>$(DefaultItemExcludes);sounds\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Sounds.fs" />
    <Compile Include="Stt.fs" />
    <Compile Include="Recorder.fs" />
    <Compile Include="Keyboard.fs" />
    <Compile Include="Pipeline.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.Hooks" Version="1.7.0" />
    <PackageReference Include="InputSimulatorPlus" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="FsToolkit.ErrorHandling.TaskResult" Version="4.18.0" />
    <PackageReference Include="dotenv.net" Version="4.0.2" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Copy sounds folder to output -->
  <ItemGroup>
    <None Include="sounds\**" CopyToOutputDirectory="PreserveNewest" LinkBase="sounds\" />
  </ItemGroup>

</Project>
